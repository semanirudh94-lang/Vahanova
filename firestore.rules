rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email == 'semanirudh@gmail.com';
    }
    function isMechanic() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mechanic';
    }
    function vehicleOwner(id) {
      return exists(/databases/$(database)/documents/vehicles/$(id))
        && get(/databases/$(database)/documents/vehicles/$(id)).data.ownerId == request.auth.uid;
    }
    match /users/{id} {
      allow get, list: if signedIn() && (request.auth.uid == id || isOwner());

      // New accounts always start as customers. Only the operator can promote
      // an account to mechanic, so a user cannot grant themselves provider access.
      allow create: if isOwner()
        || (signedIn() && request.auth.uid == id
          && request.resource.data.role == 'customer');

      allow update: if isOwner()
        || (signedIn() && request.auth.uid == id
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.jobs == resource.data.jobs
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'area', 'coord', 'upi']));
      allow delete: if isOwner();
    }
    match /publicProviders/{id} {
      allow get, list: if signedIn();
      allow create: if isMechanic() && request.auth.uid == id
        && request.resource.data.keys().hasOnly([
          'name', 'area', 'vehicleTypes', 'services', 'active', 'updatedAt'
        ]);
      allow update: if isMechanic() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'area', 'vehicleTypes', 'services', 'active', 'updatedAt'
        ]);
      allow delete: if isOwner();
    }
    match /providerPrivate/{id} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == id);
      allow list: if false;
      allow create: if isMechanic() && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['phone', 'coord', 'upi', 'updatedAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24
        && request.resource.data.upi is string
        && request.resource.data.upi.size() <= 120
        && (request.resource.data.coord == null
          || (request.resource.data.coord is list && request.resource.data.coord.size() == 2
            && request.resource.data.coord[0] is number
            && request.resource.data.coord[0] >= -90 && request.resource.data.coord[0] <= 90
            && request.resource.data.coord[1] is number
            && request.resource.data.coord[1] >= -180 && request.resource.data.coord[1] <= 180));
      allow update: if isMechanic() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'coord', 'upi', 'updatedAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24
        && request.resource.data.upi is string
        && request.resource.data.upi.size() <= 120
        && (request.resource.data.coord == null
          || (request.resource.data.coord is list && request.resource.data.coord.size() == 2
            && request.resource.data.coord[0] is number
            && request.resource.data.coord[0] >= -90 && request.resource.data.coord[0] <= 90
            && request.resource.data.coord[1] is number
            && request.resource.data.coord[1] >= -180 && request.resource.data.coord[1] <= 180));
      allow delete: if isOwner();
    }
    // Legacy documents may contain private fields; never expose them publicly.
    match /providers/{id} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == id);
      allow list: if isOwner();
      allow create, update: if false;
      allow delete: if isOwner();
    }
    match /vehicles/{id} {
      allow get, list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /bookings/{id} {
      // Pending requests are never readable from the private booking document by mechanics.
      allow get: if (signedIn() && !exists(/databases/$(database)/documents/bookings/$(id)))
        || isOwner()
        || (signedIn() && (resource.data.customerId == request.auth.uid || resource.data.mechanicId == request.auth.uid));
      allow list: if isOwner()
        || (signedIn() && (resource.data.customerId == request.auth.uid || resource.data.mechanicId == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && !request.resource.data.keys().hasAny(['mechanicPhone', 'mechanicUpi', 'mechanicCoord'])
        && ((request.resource.data.mechanicId == null && request.resource.data.status == 'pending'
          && existsAfter(/databases/$(database)/documents/openRequests/$(id))
          && getAfter(/databases/$(database)/documents/openRequests/$(id)).data.bookingId == id)
          || (request.resource.data.mechanicId is string
            && exists(/databases/$(database)/documents/publicProviders/$(request.resource.data.mechanicId))
            && get(/databases/$(database)/documents/publicProviders/$(request.resource.data.mechanicId)).data.active == true
            && request.resource.data.mechanicName == get(/databases/$(database)/documents/publicProviders/$(request.resource.data.mechanicId)).data.name
            && request.resource.data.mechanicArea == get(/databases/$(database)/documents/publicProviders/$(request.resource.data.mechanicId)).data.area
            && request.resource.data.status == 'assigned'));
      allow update: if isOwner()
        || (signedIn() && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.mechanicId == resource.data.mechanicId
          && request.resource.data.amount == resource.data.amount
          && resource.data.status in ['pending', 'assigned']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history'])
          && request.resource.data.status == 'cancelled')
        || (signedIn() && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && resource.data.status in ['pending', 'assigned', 'on_way', 'in_progress']
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coord', 'locAccuracy'])
          && request.resource.data.coord is list
          && request.resource.data.coord.size() == 2
          && request.resource.data.coord[0] is number
          && request.resource.data.coord[0] >= -90
          && request.resource.data.coord[0] <= 90
          && request.resource.data.coord[1] is number
          && request.resource.data.coord[1] >= -180
          && request.resource.data.coord[1] <= 180)
        || (isMechanic() && resource.data.mechanicId == null && resource.data.status == 'pending'
          && request.resource.data.mechanicId == request.auth.uid
          && request.resource.data.status == 'assigned'
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'mechanicId', 'status', 'etaMin', 'mechanicName', 'mechanicPhone',
            'mechanicArea', 'mechanicJobs', 'mechanicUpi', 'mechanicCoord', 'history'
          ])
          && exists(/databases/$(database)/documents/openRequests/$(id)))
        || (isMechanic() && resource.data.mechanicId == request.auth.uid
          && request.resource.data.mechanicId == resource.data.mechanicId
          && request.resource.data.customerId == resource.data.customerId
          && resource.data.status in ['assigned', 'on_way', 'in_progress']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'mechanicName', 'mechanicPhone', 'mechanicArea', 'mechanicJobs', 'mechanicUpi', 'mechanicCoord'
          ])
          && request.resource.data.mechanicName is string
          && request.resource.data.mechanicPhone is string
          && request.resource.data.mechanicUpi is string)
        || (isMechanic() && resource.data.mechanicId == request.auth.uid
          && request.resource.data.mechanicId == resource.data.mechanicId
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history', 'amount'])
          && ((resource.data.status == 'assigned' && request.resource.data.status == 'on_way')
            || (resource.data.status == 'on_way' && request.resource.data.status == 'in_progress')
            || (resource.data.status == 'in_progress' && request.resource.data.status == 'completed'
              && existsAfter(/databases/$(database)/documents/records/$(id))
              && getAfter(/databases/$(database)/documents/records/$(id)).data.mechanicId == request.auth.uid
              && getAfter(/databases/$(database)/documents/records/$(id)).data.bookingId == id)));
    }
    match /openRequests/{id} {
      // Only non-sensitive request summaries are stored in this collection.
      allow get, list: if isMechanic() && resource.data.status == 'pending';
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'bookingId', 'code', 'service', 'kind', 'date', 'createdAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'bookingId', 'code', 'service', 'kind', 'date', 'slot', 'createdAt', 'status'
        ])
        && request.resource.data.bookingId == id
        && request.resource.data.status == 'pending'
        && existsAfter(/databases/$(database)/documents/bookings/$(id))
        && getAfter(/databases/$(database)/documents/bookings/$(id)).data.customerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(id)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/bookings/$(id)).data.mechanicId == null;
      allow delete: if isOwner()
        || (isMechanic()
          && existsAfter(/databases/$(database)/documents/bookings/$(id))
          && getAfter(/databases/$(database)/documents/bookings/$(id)).data.mechanicId == request.auth.uid
          && getAfter(/databases/$(database)/documents/bookings/$(id)).data.status == 'assigned')
        || (signedIn()
          && existsAfter(/databases/$(database)/documents/bookings/$(id))
          && getAfter(/databases/$(database)/documents/bookings/$(id)).data.customerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/bookings/$(id)).data.status == 'cancelled');
      allow update: if false;
    }
    match /records/{id} {
      allow get: if isOwner()
        || (signedIn() && exists(/databases/$(database)/documents/bookings/$(id))
          && get(/databases/$(database)/documents/bookings/$(id)).data.mechanicId == request.auth.uid)
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (signedIn() && resource.data.mechanicId == request.auth.uid)
        || (signedIn() && vehicleOwner(resource.data.vehicleId));
      allow list: if isOwner()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (signedIn() && resource.data.mechanicId == request.auth.uid)
        || (signedIn() && vehicleOwner(resource.data.vehicleId));
      allow create: if isMechanic()
        && request.resource.data.mechanicId == request.auth.uid
        && request.resource.data.bookingId == id
        && existsAfter(/databases/$(database)/documents/bookings/$(id))
        && getAfter(/databases/$(database)/documents/bookings/$(id)).data.status == 'completed'
        && getAfter(/databases/$(database)/documents/bookings/$(id)).data.mechanicId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(id)).data.customerId == request.resource.data.customerId;
      allow update, delete: if isOwner();
    }
    match /ratings/{id} {
      // Full rating documents contain customer and vehicle identifiers.
      allow get, list: if isOwner()
        || (signedIn() && (resource.data.customerId == request.auth.uid
          || resource.data.providerId == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.bookingId == id
        && request.resource.data.stars is number
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.comment.size() <= 200
        && exists(/databases/$(database)/documents/bookings/$(id))
        && get(/databases/$(database)/documents/bookings/$(id)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(id)).data.status == 'completed';
      allow update, delete: if isOwner();
    }
    match /publicRatings/{id} {
      // Public reviews intentionally contain no customer or vehicle identifiers.
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'bookingId', 'providerId', 'providerName', 'service', 'stars', 'comment', 'createdAt'
        ])
        && request.resource.data.bookingId == id
        && request.resource.data.stars is number
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 200
        && exists(/databases/$(database)/documents/bookings/$(id))
        && (isOwner() || get(/databases/$(database)/documents/bookings/$(id)).data.customerId == request.auth.uid)
        && get(/databases/$(database)/documents/bookings/$(id)).data.status == 'completed'
        && get(/databases/$(database)/documents/bookings/$(id)).data.mechanicId == request.resource.data.providerId;
      allow update, delete: if isOwner();
    }
    match /meta/{id} {
      allow get, list: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1001;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
      allow delete: if isOwner();
    }
  }
}
